@page
@model IndexModel
@using System.Text.Json
@using ShipmentReport.Services
@{
    ViewData["Title"] = "Import Shipment Report";
    var f = Model.Filter;
    var s = Model.Summary;
    var chips = new (string Key, string Label, string? Value)[]
    {
        ("Origin", "Origin", f.Origin), ("Carrier", "Carrier", f.Carrier), ("Size", "Size", f.Size),
        ("Doc", "Documents", f.Doc), ("Decl", "Declaration", f.Decl),
        ("Release", "Release port", f.Release), ("Deliv", "Delivery", f.Deliv),
    };
    // Columns whose values are codes, shown in the mono face.
    var monoCols = new HashSet<string> { "Job", "Invoice No", "Container" };
    var numCols = new HashSet<string> { "Cartons", "CBM" };
}

@section NavActions {
    @if (Model.Data is not null)
    {
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
            <label class="btn btn-secondary">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 11V2.5M4.5 6L8 2.5 11.5 6M2.5 13.5h11" /></svg>
                <span>Import<span class="hide-sm"> another file</span></span>
                <input type="file" name="file" accept=".xlsx" hidden onchange="this.form.submit()" />
            </label>
        </form>
    }
}

@if (Model.Error is not null)
{
    <div class="notice notice-error" role="alert">@Model.Error</div>
}

@if (Model.Data is null)
{
    <div class="g12 empty">
        <div class="span-5 empty-copy">
            <h1 class="display">Import a shipment workbook <span class="quiet">to build the report</span></h1>
            <p class="lead">The first sheet is read. Columns are matched by their header name, so their order doesn't matter. Empty or incomplete rows are skipped and counted.</p>
            <div class="empty-cols">
                <span class="label">Headers it looks for</span>
                <div class="tokens">
                    @foreach (var h in new[] { "Job I", "Invoice No", "PO", "CTNR NO.", "Size", "Origin", "Carrier", "ETA", "Customs Release", "Delivery Date", "CBM" })
                    {
                        <span class="token">@h</span>
                    }
                </div>
            </div>
        </div>
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="dropzone" class="span-6-end dropzone">
            <svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" class="drop-icon">
                <rect x="10" y="20" width="44" height="28" rx="2" /><path d="M19 20v28M28 20v28M37 20v28M46 20v28" />
                <path class="accent" d="M32 4v12M27 11l5 5 5-5" />
            </svg>
            <div>
                <div class="drop-title">Drop an .xlsx file here</div>
                <div class="drop-sub">or choose one from your computer</div>
            </div>
            <label class="btn btn-primary">
                Choose file
                <input type="file" name="file" accept=".xlsx" hidden onchange="this.form.submit()" />
            </label>
            <div class="small quiet">Kept on the server for 4 hours, then cleared</div>
        </form>
    </div>
}
else
{
    <div class="page-head">
        <div class="stack-8">
            <h1 class="h1">Import shipments <span class="quiet">@Model.Data.FileName</span></h1>
            <p class="meta">
                Sheet “@Model.Data.SheetName” · @Model.Data.Rows.Count rows imported
                @if (Model.Data.SkippedRows > 0) { <span>· @Model.Data.SkippedRows empty or incomplete row(s) skipped</span> }
            </p>
        </div>
        <form method="post" asp-page-handler="Export" id="export" class="actions">
            <input type="hidden" name="ds" value="@Model.Ds" />
            <input type="hidden" name="DateField" value="@f.DateField" />
            <input type="hidden" name="From" value="@f.From?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="To" value="@f.To?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Q" value="@f.Q" />
            <input type="hidden" name="Group" value="@f.Group" />
            @foreach (var c in chips.Where(c => c.Value is not null))
            {
                <input type="hidden" name="@c.Key" value="@c.Value" />
            }
            <button class="btn btn-secondary" name="format" value="xlsx" type="submit">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5V11M4.5 7.5L8 11l3.5-3.5M2.5 13.5h11" /></svg>Export Excel
            </button>
            <button class="btn btn-secondary" name="format" value="pdf" type="submit">
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5V11M4.5 7.5L8 11l3.5-3.5M2.5 13.5h11" /></svg>Export PDF
            </button>
        </form>
    </div>

    <form method="get" class="panel filters" id="filters">
        <input type="hidden" name="ds" value="@Model.Ds" />
        @foreach (var c in chips.Where(c => c.Value is not null))
        {
            <input type="hidden" name="@c.Key" value="@c.Value" />
        }
        <div class="g12 fields">
            <div class="field span-3">
                <label for="DateField">Date column</label>
                <select id="DateField" name="DateField">
                    @foreach (var d in Model.Data.DateFields)
                    {
                        <option value="@d.Key" selected="@(d.Key == DateField.Get(f.DateField).Key)">@d.Label</option>
                    }
                </select>
            </div>
            <div class="field span-2">
                <label for="From">From</label>
                <input type="date" id="From" name="From" value="@f.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field span-2">
                <label for="To">To</label>
                <input type="date" id="To" name="To" value="@f.To?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field span-2">
                <label for="Group">Group chart by</label>
                <select id="Group" name="Group">
                    <option value="" selected="@(!Report.Groups.Contains(f.Group))">Auto (@s!.Group.ToLowerInvariant())</option>
                    @foreach (var g in Report.Groups)
                    {
                        <option value="@g" selected="@(g == f.Group)">@g</option>
                    }
                </select>
            </div>
            <div class="field span-3">
                <label for="Q">PO, invoice or job number</label>
                <input class="mono" type="search" id="Q" name="Q" value="@f.Q" list="numbers" autocomplete="off"
                       placeholder="Full number" title="Only a full Job, Invoice or PO number matches" />
                @* Suggestions from the whole file; the browser filters them as you type. *@
                <datalist id="numbers">
                    @foreach (var n in Model.Data.Rows.SelectMany(r => new[] { r.Job, r.Invoice, r.Po }).Where(n => n != "").Distinct().Order())
                    {
                        <option value="@n"></option>
                    }
                </datalist>
            </div>
        </div>
        <div class="filters-foot">
            <div class="chips">
                <span class="meta">Chart filters</span>
                @foreach (var c in chips.Where(c => c.Value is not null))
                {
                    <a class="chip" href="@Model.LinkWith(c.Key, null)" aria-label="Remove filter: @c.Label is @c.Value">
                        @c.Label is @c.Value
                        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 4l6 6M10 4l-6 6" /></svg>
                    </a>
                }
                @if (!chips.Any(c => c.Value is not null))
                {
                    <span class="meta quiet">None. Click a bar in a chart to add one.</span>
                }
            </div>
            <div class="actions">
                <a class="link" href="?ds=@Model.Ds">Reset</a>
                <button class="btn btn-primary" type="submit">Apply filters</button>
            </div>
        </div>
    </form>

    <section class="section" aria-labelledby="summary-h">
        <div class="section-head">
            <h2 class="h2" id="summary-h">Summary <span class="quiet">@s!.Kpis.Rows of @Model.Data.Rows.Count rows</span></h2>
            @if (s.Kpis.MissingDate > 0)
            {
                <p class="meta">@s.Kpis.MissingDate row(s) have no @DateField.Get(f.DateField).Label, so they're left out of the time chart.</p>
            }
        </div>
        <div class="g12">
            <div class="panel stat span-3"><span class="label">Containers</span><span class="stat-value">@s.Kpis.Containers.ToString("#,0")</span><span class="meta quiet">Distinct container numbers</span></div>
            <div class="panel stat span-3"><span class="label">Volume</span><span class="stat-value">@s.Kpis.Cbm.ToString("#,0.#")</span><span class="meta quiet">CBM, counted once per invoice</span></div>
            <div class="panel stat span-3"><span class="label">Jobs</span><span class="stat-value">@s.Kpis.Jobs.ToString("#,0")</span><span class="meta quiet">Distinct job numbers</span></div>
            <div class="panel stat span-3"><span class="label">Invoices</span><span class="stat-value">@s.Kpis.Invoices.ToString("#,0")</span><span class="meta quiet">@s.Kpis.RevisedInvoices with revised documents</span></div>
            <div class="panel stat-row span-3"><span class="label">ETA to customs release</span><span class="stat-sm">@(s.Kpis.AvgDaysToCustoms?.ToString("0.0") ?? "–") <span class="unit">days avg</span></span></div>
            <div class="panel stat-row span-3"><span class="label">ETA to delivery</span><span class="stat-sm">@(s.Kpis.AvgDaysToDelivery?.ToString("0.0") ?? "–") <span class="unit">days avg</span></span></div>
            <div class="panel stat-row span-3" title="Delivered containers with a delivery plan, delivered on or before the plan day">
                <span class="label">Delivered on time</span>
                <span class="stat-sm">@(s.Kpis.OnTimePercent is { } pct ? pct.ToString("0.#") + "%" : "–") <span class="unit">@s.Kpis.OnTimeContainers of @(s.Kpis.OnTimeContainers + s.Kpis.LateContainers)</span></span>
            </div>
            <a class="panel stat-row span-3 stat-link" href="@Model.LinkWith("Deliv", "Not delivered")" title="Show only containers with no delivery date">
                <span class="label">Not delivered yet</span>
                <span class="stat-sm">@s.Kpis.NotDeliveredContainers <span class="unit">containers</span></span>
            </a>
        </div>
    </section>

    @if (Model.Rows.Count == 0)
    {
        <div class="notice">
            @if (!string.IsNullOrWhiteSpace(f.Q) && Report.Filter(Model.Data.Rows, new ReportFilter { Q = f.Q }).Count == 0)
            {
                <span>No job, invoice or PO number is exactly “@f.Q.Trim()”. Type the full number, or pick one from the suggestions.</span>
            }
            else
            {
                <span>No rows match these filters.</span>
            }
            <a class="link" href="?ds=@Model.Ds">Reset filters</a>
        </div>
    }
    else
    {
        var group = s.Group.ToLowerInvariant();
        <section class="section" aria-labelledby="charts-h">
            <div class="section-head">
                <h2 class="h2" id="charts-h">Breakdown <span class="quiet">click a bar to filter</span></h2>
            </div>
            <div class="g12">
                <div class="panel chart-card span-8" data-title="Containers per @group">
                    <div class="card-head"><h3 class="h3">Containers per @group</h3><p class="meta">By @DateField.Get(f.DateField).Label, stacked by size. Click a size in the legend to filter by it.</p></div>
                    <div class="chart-box tall"><canvas data-chart="daily" role="img" aria-label="Containers per @group, stacked by size"></canvas></div>
                </div>
                <div class="span-4 stack-24">
                    <div class="panel chart-card" data-title="Document status">
                        <div class="card-head"><h3 class="h3">Documents</h3><p class="meta">Invoices with revised documents</p></div>
                        <div class="chart-box strip"><canvas data-chart="doc" role="img" aria-label="Document status by invoice"></canvas></div>
                    </div>
                    <div class="panel chart-card" data-title="Declaration status">
                        <div class="card-head"><h3 class="h3">Declarations</h3><p class="meta">Invoices by declaration status</p></div>
                        <div class="chart-box strip"><canvas data-chart="decl" role="img" aria-label="Declaration status by invoice"></canvas></div>
                    </div>
                </div>
                <div class="panel chart-card span-6" data-title="By origin port">
                    <div class="card-head"><h3 class="h3">By origin port</h3><p class="meta">Containers, with volume in CBM</p></div>
                    <div class="chart-box" style="height: @(Math.Max(160, s.ByOrigin.Labels.Count * 44 + 24))px"><canvas data-chart="origin" role="img" aria-label="Containers by origin port"></canvas></div>
                </div>
                <div class="panel chart-card span-6" data-title="By carrier">
                    <div class="card-head"><h3 class="h3">By carrier</h3><p class="meta">Containers, with volume in CBM</p></div>
                    <div class="chart-box" style="height: @(Math.Max(160, s.ByCarrier.Labels.Count * 44 + 24))px"><canvas data-chart="carrier" role="img" aria-label="Containers by carrier"></canvas></div>
                </div>
                <div class="panel chart-card span-4" data-title="Delivery status">
                    <div class="card-head"><h3 class="h3">Delivery</h3><p class="meta">Containers, delivery date against plan</p></div>
                    <div class="chart-box strip"><canvas data-chart="deliv" role="img" aria-label="Delivery status by container"></canvas></div>
                </div>
                <div class="panel chart-card span-8" data-title="By release port">
                    <div class="card-head"><h3 class="h3">By release port</h3><p class="meta">Containers, with volume in CBM</p></div>
                    <div class="chart-box" style="height: @(Math.Max(160, s.ByReleasePort.Labels.Count * 44 + 24))px"><canvas data-chart="release" role="img" aria-label="Containers by release port"></canvas></div>
                </div>
                <div class="panel chart-card span-12" data-title="Lead time from ETA">
                    <div class="card-head"><h3 class="h3">Lead time from ETA</h3><p class="meta">Average days per invoice, by origin</p></div>
                    <div class="chart-box" style="height: @(Math.Max(180, s.LeadTime.Labels.Count * 56 + 60))px"><canvas data-chart="lead" role="img" aria-label="Average lead time by origin"></canvas></div>
                </div>
            </div>
        </section>

        <section class="section" aria-labelledby="rows-h">
            <div class="section-head">
                <h2 class="h2" id="rows-h">Shipments <span class="quiet">@Model.Rows.Count rows</span></h2>
                <p class="meta">Click a column to sort</p>
            </div>
            <div class="panel table-wrap">
                <table id="rows">
                    <thead>
                        <tr>@foreach (var c in KeyColumns.All) { <th scope="col" class="@(numCols.Contains(c.Label) ? "num" : null)">@c.Label</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>@foreach (var c in KeyColumns.All) { <td class="@(monoCols.Contains(c.Label) ? "mono" : numCols.Contains(c.Label) ? "num" : null)">@c.Value(r)</td> }</tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <script type="application/json" id="report-data">@Html.Raw(JsonSerializer.Serialize(new { summary = s, filter = new { f.DateField, f.Origin, f.Carrier, f.Size, f.Doc, f.Decl } }, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    }
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/report.js" asp-append-version="true"></script>
}
